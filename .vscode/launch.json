{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Start Web",
      "runtimeArgs": [
          "run-script", "start:web"
      ],
      "args": ["-- --document", "https://swotde-my.sharepoint.com/:x:/r/personal/kal_swot_de/_layouts/15/Doc.aspx?sourcedoc=%7BE0A5F193-14B9-4BDF-9131-A639DCE4B080%7D" ],
      "skipFiles": [
          "<node_internals>/**"
      ],
      "program": "${workspaceFolder}\\myaddin\\src\\functions\\functions.js"
  },
    {
      "name": "Excel Desktop (Edge Chromium)",
      "type": "msedge",
      "request": "attach",
      "port": 3000,
      "timeout": 600000,
      "url":"https://swotde-my.sharepoint.com/:x:/r/personal/kal_swot_de/_layouts/15/Doc.aspx?sourcedoc=%7BE0A5F193-14B9-4BDF-9131-A639DCE4B080%7D",
      "webRoot": "${workspaceRoot}",
      "preLaunchTask": "Debug: Excel Desktop",
      "postDebugTask": "Stop Debug"
    },
    {
      "name": "Excel Desktop (Edge Legacy)",
      "type": "office-addin",
      "request": "attach",
      "url": "https://localhost:3000/taskpane.html?_host_Info=Excel$Win32$16.01$en-US$$$$0",
      "port": 9222,
      "timeout": 600000,
      "webRoot": "${workspaceRoot}",
      "preLaunchTask": "Debug: Excel Desktop",
      "postDebugTask": "Stop Debug"
    },

  ]
}